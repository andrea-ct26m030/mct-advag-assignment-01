<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visuals="using:ConvexHull.Visualization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ConvexHull.MainWindow"
        Title="Convex Hull Visualizer"
        Width="500"
        Height="500">
    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Vertical">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">
                <!-- Data selection -->
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DataSelector"
                              SelectionChanged="Data_SelectionChanged" />
                </StackPanel>
                <!-- Operation selection -->
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="OperationSelector"
                              SelectionChanged="Operation_SelectionChanged" />
                </StackPanel>
                <!-- Algorithm selection -->
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="AlgorithmSelector"
                              SelectionChanged="Algorithm_SelectionChanged" />
                </StackPanel>
                <NumericUpDown x:Name="PointCountInput"
                               ValueChanged="Count_ValueChanged"
                               Minimum="3"
                               Maximum="100000"
                               Value="5"
                               IsVisible="True" />
                <Button x:Name="FilePickerButton"
                        Content="Load from File"
                        Click="FilePicker_Click" 
                        IsVisible="False" />
                <TextBlock x:Name="FilePathTextBlock"
                           Text=""
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           IsVisible="False" />
            </StackPanel>
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Start"
                        Click="Start_Click" />
                <Button x:Name="NextStepButton"
                        Content="Next Step"
                        Click="NextStep_Click" 
                        IsVisible="False" />
            </StackPanel>
        </StackPanel>
        <!-- Drawing area -->
        <Border Grid.Row="1"
                Background="#111827"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <visuals:HullCanvas x:Name="HullCanvasView" />
        </Border>
    </Grid>
</Window>
