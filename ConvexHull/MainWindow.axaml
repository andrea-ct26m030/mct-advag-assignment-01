<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visuals="using:ConvexHull.Visualization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ConvexHull.MainWindow"
        Title="Convex Hull Visualizer"
        Width="500"
        Height="500">
    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="16">
            <Button Content="Generate Points"
                    Click="GeneratePoints_Click" />
            <Button Content="Next Step"
                    Click="NextStep_Click" />
        </StackPanel>
        <!-- Drawing area -->
        <Border Grid.Row="1"
                Background="#111827"
                Margin="16"
                CornerRadius="8"
                ClipToBounds="True">
            <visuals:HullCanvas />
        </Border>
    </Grid>
</Window>
